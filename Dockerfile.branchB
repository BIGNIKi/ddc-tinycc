# Образ для проверяемой ветки B в схеме DDC.
#
# Идея: взять НЕЗАВИСИМЫЙ компилятор (gcc из Alpine Linux, musl-native, другой версии),
# но собирать им tinycc против ТЕХ ЖЕ musl-заголовков /x86_64, что и ветка A.
# Тогда единственное отличие между ветками — сам компилятор, а окружение одинаковое.
#
# Сборка образа (из корня репозитория ddc-tinycc, образ trusted-toolchain уже должен быть собран и лежат в локальном хранилище образов Docker):
#   docker build -f Dockerfile.branchB -t ddc-alpine .

# 1) достаём /x86_64 (наши доверенные musl-заголовки, библиотеки, crt) из образа ветки A
# P.S. crt - стартовые файлы программы (crt1.o, crti.o, crtn.o). То есть это точка входа _start, которая запускается ещё до main; а также логика, которая выполняется после main.
FROM trusted-toolchain AS trusted

# 2) берём чистый Alpine с его родным gcc (независимая сборка, musl-native)
FROM alpine:3.23

# переносим наше musl-окружение /x86_64 в Alpine-образ.
# Тогда ветка B будет брать заголовки, библиотеки и crt из наших /x86_64,
# а не из родных для Alpine. У веток A и B окружение станет одинаковым —
# и побайтовое сравнение A2 и B2 будет честным (различия, если будут,
# только из-за компилятора, а не из-за разных версий musl).
COPY --from=trusted /x86_64 /x86_64

# apk - менеджер пакетов Alpine Linux. apk add - ставит пакеты
# gcc - всегда будет 15 версия
# musl-dev — заголовки musl и crt от Alpine. Нужны, чтобы gcc вообще мог что-то компилировать: пакет gcc сам по себе libc не содержит, без заголовков он даже stdio.h не найдёт.
# binutils - набор утилит. Нам нужен ar (собирает .a-библиотеки, например libtcc.a) и ld (линковщик, gcc вызывает его внутри себя при сборке).
# make - базовый Alpine не содержит этой программы (нужна, чтобы Makefile'ы собирать).
RUN apk add --no-cache gcc musl-dev binutils make
